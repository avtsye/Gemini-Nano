{
  "manifest_version": 3,
  "name": "Gemini Nano Local Workspace",
  "version": "1.0.0",
  "description": "סביבת AI מקומית ל-Chrome עם Gemini Nano: צ'אט, זיכרון, עמודים, קבצים, תמונות, אבחון וכלי עבודה — ללא API key.",
  "minimum_chrome_version": "148",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Nano",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}